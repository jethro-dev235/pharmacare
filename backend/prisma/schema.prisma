generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  password  String
  role      String   @default("caissier")
  createdAt DateTime @default(now())
  ventes    Vente[]
}

model Medicament {
  id             Int         @id @default(autoincrement())
  nom            String
  categorie      String
  description    String?
  prixAchat      Float
  prixVente      Float
  quantite       Int         @default(0)
  dateExpiration DateTime
  codeBarres     String?     @unique
  fabricant      String?
  createdAt      DateTime    @default(now())
  stocks         Stock[]
  venteItems     VenteItem[]
}

model Stock {
  id           Int        @id @default(autoincrement())
  type         String
  quantite     Int
  date         DateTime   @default(now())
  motif        String?
  medicamentId Int
  medicament   Medicament @relation(fields: [medicamentId], references: [id])
}

model Fournisseur {
  id        Int      @id @default(autoincrement())
  nom       String
  telephone String?
  adresse   String?
  email     String?
  createdAt DateTime @default(now())
}

model Client {
  id        Int      @id @default(autoincrement())
  nom       String
  telephone String?
  email     String?
  adresse   String?
  createdAt DateTime @default(now())
  ventes    Vente[]
}

model Vente {
  id        Int         @id @default(autoincrement())
  numero    String      @unique
  dateVente DateTime    @default(now())
  montant   Float
  clientId  Int?
  client    Client?     @relation(fields: [clientId], references: [id])
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  items     VenteItem[]
}

model VenteItem {
  id           Int        @id @default(autoincrement())
  quantite     Int
  prixUnitaire Float
  venteId      Int
  vente        Vente      @relation(fields: [venteId], references: [id])
  medicamentId Int
  medicament   Medicament @relation(fields: [medicamentId], references: [id])
}